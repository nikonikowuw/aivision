# RK3576 RKNN YOLOv8n Package Private Config
# Algorithm private settings loaded from <package_root>/.env
# Note: In-library std::getenv is strictly forbidden.

# Model path relative to package_root or absolute path
MODEL_PATH=model/yolov8n.rknn

# Detection thresholds
CONF_THRESH=0.25
IOU_THRESH=0.45

# Self-test input/output for standalone testing
INPUT_IMAGE=testimage.jpg
OUTPUT_IMAGE=result.jpg
