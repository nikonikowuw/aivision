if(NOT DEFINED STAGING_DIR OR NOT DEFINED SOURCE_MANIFEST OR NOT DEFINED ENTRY_LIBRARY)
    message(FATAL_ERROR "Package validation requires STAGING_DIR, SOURCE_MANIFEST and ENTRY_LIBRARY")
endif()

if(NOT EXISTS "${SOURCE_MANIFEST}")
    message(FATAL_ERROR "Manifest source does not exist: ${SOURCE_MANIFEST}")
endif()

file(READ "${SOURCE_MANIFEST}" manifest)
string(JSON manifest_type ERROR_VARIABLE manifest_type_error TYPE "${manifest}")
if(manifest_type_error OR NOT manifest_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Manifest must be a JSON object")
endif()

# Top-level fields per updated manifest-schema.md
set(allowed_top_level
    manifest_version algorithm_id version name description algorithm_type alarm_type_id
    platform_id min_adapter_version runtime_constraints resource_profile self_test)
string(JSON top_level_count LENGTH "${manifest}")
if(top_level_count GREATER 0)
    math(EXPR top_level_last "${top_level_count} - 1")
    foreach(index RANGE 0 ${top_level_last})
        string(JSON key MEMBER "${manifest}" ${index})
        list(FIND allowed_top_level "${key}" key_index)
        if(key_index EQUAL -1)
            message(FATAL_ERROR "Manifest contains an unknown top-level field: ${key}")
        endif()
    endforeach()
endif()

foreach(required_field IN ITEMS manifest_version algorithm_id version name algorithm_type
                              platform_id min_adapter_version runtime_constraints resource_profile self_test)
    string(JSON field_type ERROR_VARIABLE field_error TYPE "${manifest}" "${required_field}")
    if(field_error)
        message(FATAL_ERROR "Manifest is missing required field: ${required_field}")
    endif()
endforeach()

string(JSON manifest_version GET "${manifest}" manifest_version)
if(NOT manifest_version STREQUAL "1")
    message(FATAL_ERROR "Only manifest_version 1 is supported")
endif()

string(JSON algorithm_id GET "${manifest}" algorithm_id)
string(LENGTH "${algorithm_id}" algorithm_id_length)
if(algorithm_id_length LESS 3 OR algorithm_id_length GREATER 32 OR
   NOT algorithm_id MATCHES "^[a-z0-9_-]+$")
    message(FATAL_ERROR "Manifest algorithm_id is invalid")
endif()

string(JSON version GET "${manifest}" version)
if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "Manifest version is not SemVer: ${version}")
endif()

string(JSON name GET "${manifest}" name)
string(LENGTH "${name}" name_length)
if(name_length LESS 1 OR name_length GREATER 64)
    message(FATAL_ERROR "Manifest name length is invalid")
endif()
string(JSON description_type ERROR_VARIABLE description_error TYPE "${manifest}" description)
if(NOT description_error STREQUAL "NOTFOUND")
    if(NOT description_type STREQUAL "STRING")
        message(FATAL_ERROR "Manifest description must be a string")
    endif()
    string(JSON description GET "${manifest}" description)
    string(LENGTH "${description}" description_length)
    if(description_length GREATER 256)
        message(FATAL_ERROR "Manifest description is too long")
    endif()
endif()

string(JSON algorithm_type GET "${manifest}" algorithm_type)
set(allowed_algorithm_types object_detection face_recognition)
list(FIND allowed_algorithm_types "${algorithm_type}" algorithm_type_index)
if(algorithm_type_index EQUAL -1)
    message(FATAL_ERROR "Unsupported algorithm_type: ${algorithm_type} (allowed: object_detection, face_recognition)")
endif()
string(JSON alarm_type_id ERROR_VARIABLE alarm_type_id_error GET "${manifest}" alarm_type_id)
if(algorithm_type STREQUAL "object_detection")
    if(alarm_type_id_error)
        message(FATAL_ERROR "object_detection manifests require alarm_type_id")
    endif()
    string(LENGTH "${alarm_type_id}" alarm_type_id_length)
    if(alarm_type_id_length LESS 3 OR alarm_type_id_length GREATER 32 OR
       NOT alarm_type_id MATCHES "^[a-z0-9_]+$")
        message(FATAL_ERROR "Manifest alarm_type_id is invalid")
    endif()
else()
    # face_recognition：首版 manifest 不声明 alarm_type_id；若声明必须明确拒绝，
    # 避免产生隐式告警语义（见 face_recognition design.md §3.3）。
    if(NOT alarm_type_id_error)
        message(FATAL_ERROR "face_recognition manifests must not declare alarm_type_id")
    endif()
endif()

string(JSON platform_id GET "${manifest}" platform_id)
if(NOT platform_id MATCHES "^[a-z0-9]+(-[a-z0-9]+)+$")
    message(FATAL_ERROR "Manifest platform_id is invalid")
endif()
string(JSON min_adapter_version GET "${manifest}" min_adapter_version)
if(NOT min_adapter_version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "Manifest min_adapter_version is not SemVer: ${min_adapter_version}")
endif()

string(JSON runtime_type TYPE "${manifest}" runtime_constraints)
if(NOT runtime_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Manifest runtime_constraints must be an object")
endif()

string(JSON resource_type TYPE "${manifest}" resource_profile)
if(NOT resource_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Manifest resource_profile must be an object")
endif()
string(JSON resource_count LENGTH "${manifest}" resource_profile)
if(resource_count GREATER 0)
    math(EXPR resource_last "${resource_count} - 1")
    foreach(index RANGE 0 ${resource_last})
        string(JSON key MEMBER "${manifest}" resource_profile ${index})
        if(NOT key STREQUAL "min_free_memory_mb" AND NOT key STREQUAL "fps_tiers")
            message(FATAL_ERROR "Unknown resource_profile field: ${key}")
        endif()
    endforeach()
endif()
string(JSON min_memory GET "${manifest}" resource_profile min_free_memory_mb)
if(NOT min_memory MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "resource_profile.min_free_memory_mb must be a positive integer")
endif()
string(JSON tier_type TYPE "${manifest}" resource_profile fps_tiers)
if(NOT tier_type STREQUAL "ARRAY")
    message(FATAL_ERROR "resource_profile.fps_tiers must be an array")
endif()
string(JSON tier_count LENGTH "${manifest}" resource_profile fps_tiers)
if(tier_count LESS 1)
    message(FATAL_ERROR "resource_profile.fps_tiers must not be empty")
endif()
set(previous_fps 0)
math(EXPR tier_last "${tier_count} - 1")
foreach(index RANGE 0 ${tier_last})
    string(JSON tier_object_type TYPE "${manifest}" resource_profile fps_tiers ${index})
    if(NOT tier_object_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Every fps tier must be an object")
    endif()
    string(JSON tier_fields LENGTH "${manifest}" resource_profile fps_tiers ${index})
    if(NOT tier_fields EQUAL 2)
        message(FATAL_ERROR "Every fps tier must contain only fps and units")
    endif()
    string(JSON fps GET "${manifest}" resource_profile fps_tiers ${index} fps)
    string(JSON units GET "${manifest}" resource_profile fps_tiers ${index} units)
    if(NOT fps MATCHES "^[1-9][0-9]*$" OR NOT units MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "fps tier values must be positive integers")
    endif()
    if(fps LESS_EQUAL previous_fps OR units GREATER 1000)
        message(FATAL_ERROR "fps tiers must be strictly increasing and units <= 1000")
    endif()
    set(previous_fps "${fps}")
endforeach()

string(JSON self_test_type TYPE "${manifest}" self_test)
if(NOT self_test_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Manifest self_test must be an object")
endif()
string(JSON self_test_count LENGTH "${manifest}" self_test)
if(NOT self_test_count EQUAL 2)
    message(FATAL_ERROR "Manifest self_test must contain timeout_ms and input_mode")
endif()
string(JSON timeout_ms GET "${manifest}" self_test timeout_ms)
if(NOT timeout_ms MATCHES "^[1-9][0-9]*$" OR timeout_ms LESS 1 OR timeout_ms GREATER 60000)
    message(FATAL_ERROR "self_test.timeout_ms must be in [1, 60000]")
endif()
string(JSON input_mode GET "${manifest}" self_test input_mode)
if(NOT input_mode STREQUAL "test_image")
    message(FATAL_ERROR "self_test.input_mode must be test_image")
endif()

# Check standard convention files
if(NOT EXISTS "${STAGING_DIR}/${ENTRY_LIBRARY}" OR IS_DIRECTORY "${STAGING_DIR}/${ENTRY_LIBRARY}")
    message(FATAL_ERROR "Standard library entry is missing: ${ENTRY_LIBRARY}")
endif()
if(NOT EXISTS "${STAGING_DIR}/testimage.jpg" OR IS_DIRECTORY "${STAGING_DIR}/testimage.jpg")
    message(FATAL_ERROR "Standard test image testimage.jpg is missing")
endif()

if(EXISTS "${STAGING_DIR}/config.schema.json")
    file(READ "${STAGING_DIR}/config.schema.json" config_schema)
    string(JSON schema_type ERROR_VARIABLE schema_error TYPE "${config_schema}")
    if(schema_error OR NOT schema_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Config schema must be a JSON object schema")
    endif()
    string(JSON schema_root_type ERROR_VARIABLE schema_root_error TYPE "${config_schema}" type)
    if(schema_root_error OR NOT schema_root_type STREQUAL "STRING")
        message(FATAL_ERROR "Config schema type is required")
    endif()
    string(JSON schema_type_value GET "${config_schema}" type)
    if(NOT schema_type_value STREQUAL "object")
        message(FATAL_ERROR "Config schema root type must be object")
    endif()
    string(JSON additional_properties ERROR_VARIABLE additional_properties_error GET "${config_schema}" additionalProperties)
    if(additional_properties_error OR NOT additional_properties STREQUAL "OFF")
        message(FATAL_ERROR "Config schema must set additionalProperties=false")
    endif()
endif()

if(EXISTS "${STAGING_DIR}/.env")
    if(IS_DIRECTORY "${STAGING_DIR}/.env" OR IS_SYMLINK "${STAGING_DIR}/.env")
        message(FATAL_ERROR ".env must be a regular file")
    endif()
    file(STRINGS "${STAGING_DIR}/.env" env_lines)
    set(model_path "")
    foreach(env_line IN LISTS env_lines)
        if(env_line MATCHES "^[ \t]*MODEL_PATH[ \t]*=[ \t]*(.*)$")
            set(model_path "${CMAKE_MATCH_1}")
            string(STRIP "${model_path}" model_path)
            string(LENGTH "${model_path}" model_path_length)
            if(model_path_length GREATER 1)
                math(EXPR model_path_last "${model_path_length} - 1")
                string(SUBSTRING "${model_path}" 0 1 model_path_first)
                string(SUBSTRING "${model_path}" ${model_path_last} 1 model_path_last_char)
                if((model_path_first STREQUAL "\"" AND model_path_last_char STREQUAL "\"") OR
                   (model_path_first STREQUAL "'" AND model_path_last_char STREQUAL "'"))
                    math(EXPR model_path_inner_length "${model_path_length} - 2")
                    string(SUBSTRING "${model_path}" 1 ${model_path_inner_length} model_path)
                endif()
            endif()
        endif()
    endforeach()
    if(NOT model_path STREQUAL "")
        if(IS_ABSOLUTE "${model_path}" OR model_path MATCHES "(^|/)\\.\\.?(/|$)" OR
           model_path MATCHES "[;\\r\\n]" OR model_path MATCHES "\\\\")
            message(FATAL_ERROR "MODEL_PATH must be a safe relative path: ${model_path}")
        endif()
        string(REPLACE "/" ";" model_components "${model_path}")
        set(model_component_path "${STAGING_DIR}")
        foreach(component IN LISTS model_components)
            if(component STREQUAL "")
                message(FATAL_ERROR "MODEL_PATH contains an empty path component")
            endif()
            set(model_component_path "${model_component_path}/${component}")
            if(IS_SYMLINK "${model_component_path}")
                message(FATAL_ERROR "MODEL_PATH contains a symbolic link: ${model_path}")
            endif()
        endforeach()
        set(model_target "${STAGING_DIR}/${model_path}")
        if(NOT EXISTS "${model_target}" OR IS_SYMLINK "${model_target}")
            message(FATAL_ERROR "MODEL_PATH target does not exist: ${model_path}")
        endif()
        get_filename_component(staging_real "${STAGING_DIR}" REALPATH)
        get_filename_component(model_real "${model_target}" REALPATH)
        string(FIND "${model_real}" "${staging_real}/" model_root_prefix)
        if(NOT model_root_prefix EQUAL 0)
            message(FATAL_ERROR "MODEL_PATH target escapes package root: ${model_path}")
        endif()
        if(model_path MATCHES "\\.mlpackage$")
            if(NOT IS_DIRECTORY "${model_target}")
                message(FATAL_ERROR "MODEL_PATH .mlpackage target must be a directory: ${model_path}")
            endif()
            file(GLOB_RECURSE model_entries LIST_DIRECTORIES true "${model_target}/*")
            foreach(model_entry IN LISTS model_entries)
                if(IS_SYMLINK "${model_entry}")
                    message(FATAL_ERROR "MODEL_PATH package contains a symbolic link: ${model_entry}")
                endif()
            endforeach()
        elseif(model_path MATCHES "\\.(rknn|om)$" AND IS_DIRECTORY "${model_target}")
            message(FATAL_ERROR "MODEL_PATH binary target must be a file: ${model_path}")
        endif()
    endif()
endif()

file(WRITE "${STAGING_DIR}/manifest.json" "${manifest}\n")
