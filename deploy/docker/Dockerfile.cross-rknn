# syntax=docker/dockerfile:1
# 采用 Ubuntu 22.04 作为通用交叉编译底座
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# 1. 安装 aarch64 交叉编译工具链及必需的构建工具
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    cmake \
    ninja-build \
    ccache \
    git \
    curl \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*

# 2. 从官方拉取并部署 Rockchip rknpu2 用户态头文件与 aarch64 动态库到交叉编译器环境
WORKDIR /tmp/rknpu2
RUN git clone --depth=1 https://github.com/airockchip/rknpu2.git . && \
    mkdir -p /usr/aarch64-linux-gnu/include /usr/aarch64-linux-gnu/lib && \
    cp runtime/Linux/librknn_api/include/* /usr/aarch64-linux-gnu/include/ && \
    cp runtime/Linux/librknn_api/aarch64/librknnrt.so /usr/aarch64-linux-gnu/lib/ && \
    rm -rf /tmp/rknpu2

# 3. 设置工作目录
WORKDIR /workspace

CMD ["/bin/bash"]
